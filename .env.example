# 백엔드 DB 접속 정보 예시. 이 파일을 .env로 복사한 뒤 실제 값으로 바꾼다.
# .env는 Git에 올리지 않는다. 아래 비밀번호는 가짜 값이다.
# 서버 한 대: DB_HOST=127.0.0.1
# DB 서버 분리: DB_HOST를 DB 서버 주소로 바꾼다. DB 서버에서는 MariaDB bind-address를 열고,
#   App 서버 주소 전용 계정('lunch_app'@'<App 서버 IP>')에 lunch_slot 권한만 준다.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=lunch_slot
DB_USER=lunch_app
DB_PASSWORD=change-me
