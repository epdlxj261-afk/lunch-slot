# App 서버에서 lunch-slot API(FastAPI)를 실행하는 systemd 서비스.
# 설치: sudo bash deploy/setup_app_server.sh (이 파일을 /etc/systemd/system/에 복사한다)
# DB 접속 정보는 /opt/lunch-slot/.env(root:lunchslot, 640)에서 backend/database.py가 읽는다.
[Unit]
Description=lunch-slot API (FastAPI)
After=network-online.target mariadb.service
Wants=network-online.target

[Service]
Type=simple
# 코드·가상환경은 root 소유로 두고, 서비스는 쓰기 권한 없는 전용 사용자로 실행한다.
User=lunchslot
Group=lunchslot
WorkingDirectory=/opt/lunch-slot
# 주소·포트는 설정값으로 둔다. 127.0.0.1:8080은 FastAPI만 사용하고, 같은 서버의 Nginx(8081)가 /api를 이 주소로 전달한다.
# Web·App 서버를 분리하면 API_HOST를 App 서버 사설 IP로 바꾸고 방화벽에서 Web 서버만 허용한다.
Environment=API_HOST=127.0.0.1
Environment=API_PORT=8080
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
# 운영 실행이므로 --reload를 쓰지 않는다.
ExecStart=/opt/lunch-slot/.venv/bin/python -m uvicorn backend.main:app --host ${API_HOST} --port ${API_PORT}
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
